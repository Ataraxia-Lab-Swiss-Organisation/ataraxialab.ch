# -----------------------------------------------
# Ataraxia Lab — .htaccess — 01.07.2026
# Réconciliation root/src (dérive constatée D-2 : root avait le rewrite
# performance.json mais pas le fix style-src ; src avait l'inverse — les
# 2 fichiers sont désormais synchronisés).
# -----------------------------------------------
# Redirection HTTPS
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# Exposition scores PageSpeed Insights — D-1, 30.06.2026
RewriteRule ^performance\.json$ cron-data/performance.json [L]
# Exposition debug contact-handler — TEMPORAIRE, à retirer après stabilisation D-2 (principal.md §8)
RewriteRule ^contact-debug\.json$ cron-data/contact-debug.json [L]
# Headers de sécurité
<IfModule mod_headers.c>
  # HSTS — force HTTPS pendant 1 an
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Empêche le MIME sniffing
  Header always set X-Content-Type-Options "nosniff"
  # Empêche l'affichage en iframe (clickjacking)
  Header always set X-Frame-Options "DENY"
  # Contrôle les informations de référent
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Permissions navigateur — désactive les fonctions non utilisées
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # Content Security Policy — 24.05.2026 : hashes calculés sur les scripts inline (sans unsafe-inline)
  # Content Security Policy — 05.06.2026 : ajout IK Newsletter + Matomo cookieless
  # Content Security Policy — 12.06.2026 : suppression unsafe-inline (style-src)
  # Content Security Policy — 01.07.2026 : retrait formspree.io (D-2, sortie du sous-traitant US)
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-MlBsOVMYfpbOVe8PbB3pEcz7tgfvRJ0Cc7bIGE8308Y=' 'sha256-HmIvnGAerCvcfrt3E3r0fjJQf5HknuqVlpFIzB5wZkc=' 'sha256-QcpggXZLv/c2Kg5G2wv2/rrN6rl/dm0sUUPTXHFMfIQ=' 'sha256-MwyJc1irjTKu9j9tLpbg99UP1FlbkICtigS/9+B1T/c=' https://webform.statslive.info https://newsletter.infomaniak.com https://stats.ataraxialab.ch; style-src 'self'; font-src 'self'; img-src 'self' data: https://newsletter.infomaniak.com https://stats.ataraxialab.ch; form-action 'self' https://newsletter.infomaniak.com; connect-src 'self' https://newsletter.infomaniak.com https://stats.ataraxialab.ch; worker-src 'self' blob: https://newsletter.infomaniak.com; frame-src 'self' https://newsletter.infomaniak.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
</IfModule>
# Cache statique — fichiers immuables
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>
# Page 404 personnalisée
ErrorDocument 404 /404.html
