#!/usr/bin/env bash
# ============================================================
# pre-commit — Lint local rapide (fichiers stagés uniquement)
# Ataraxia Lab — installe via : cp .git/hooks/pre-commit puis chmod +x
# ============================================================
# Vérifie UNIQUEMENT les fichiers stagés pour le commit.
# Bloque le commit si erreur de syntaxe PHP, ESLint ou stylelint.
# Rapide (<5s) — les vérifications lourdes (PHPStan, Sonar) sont dans pre-push.
# ============================================================

set -e

# ── Couleurs ──────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

ok()   { echo -e "${GREEN}  ✓${NC} $1"; }
fail() { echo -e "${RED}  ✗${NC} $1"; exit 1; }
info() { echo -e "${YELLOW}[pre-commit]${NC} $1"; }

# ── Fichiers stagés par type ───────────────────────────────
PHP_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.php$' || true)
JS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|mjs|cjs)$' || true)
CSS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(css|scss|less)$' || true)

# ── 1. PHP syntax (php -l) ─────────────────────────────────
if [ -n "$PHP_FILES" ]; then
    info "PHP lint sur $(echo "$PHP_FILES" | wc -l | tr -d ' ') fichier(s)..."
    PHPBIN="${PHPBIN:-php}"
    ERR=0
    while IFS= read -r f; do
        if ! "$PHPBIN" -l "$f" > /dev/null 2>&1; then
            echo -e "  ${RED}✗${NC} $f"
            "$PHPBIN" -l "$f" 2>&1 | grep -v "^No syntax"
            ERR=1
        fi
    done <<< "$PHP_FILES"
    [ "$ERR" -eq 0 ] && ok "PHP lint OK" || fail "PHP lint — corriger avant commit"
fi

# ── 2. ESLint (fichiers JS) ────────────────────────────────
if [ -n "$JS_FILES" ] && [ -f "eslint.config.mjs" -o -f "eslint.config.js" -o -f ".eslintrc.js" -o -f ".eslintrc.json" ]; then
    info "ESLint sur $(echo "$JS_FILES" | wc -l | tr -d ' ') fichier(s)..."
    if command -v npx > /dev/null 2>&1; then
        if ! echo "$JS_FILES" | xargs npx eslint --max-warnings=0 2>&1; then
            fail "ESLint — corriger avant commit"
        fi
        ok "ESLint OK"
    else
        info "npx absent — ESLint ignoré"
    fi
fi

# ── 3. stylelint (fichiers CSS) ───────────────────────────
if [ -n "$CSS_FILES" ] && [ -f ".stylelintrc.json" -o -f ".stylelintrc.js" ]; then
    info "stylelint sur $(echo "$CSS_FILES" | wc -l | tr -d ' ') fichier(s)..."
    if command -v npx > /dev/null 2>&1; then
        if ! echo "$CSS_FILES" | xargs npx stylelint 2>&1; then
            fail "stylelint — corriger avant commit"
        fi
        ok "stylelint OK"
    else
        info "npx absent — stylelint ignoré"
    fi
fi

echo -e "${GREEN}[pre-commit] OK — commit autorisé${NC}"
exit 0