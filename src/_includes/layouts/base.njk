<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if "Ataraxia Lab" in title %}{{ title }}{% else %}{{ title }} — Ataraxia Lab{% endif %}</title>
  <meta name="description" content="{{ description }}">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://ataraxialab.ch{{ page.url }}">

  <!-- Open Graph -->
  <meta property="og:site_name" content="Ataraxia Lab">
  <meta property="og:title" content="{% if 'Ataraxia Lab' in title %}{{ title }}{% else %}{{ title }} — Ataraxia Lab{% endif %}">
  <meta property="og:description" content="{{ description }}">
  {% if type == 'tutoriel' %}
  <meta property="og:type" content="article">
  {% else %}
  <meta property="og:type" content="website">
  {% endif %}
  <meta property="og:url" content="https://ataraxialab.ch{{ page.url }}">
  <meta property="og:locale" content="fr_CH">
  <meta property="og:image" content="https://ataraxialab.ch/images/og-default.jpg">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{% if 'Ataraxia Lab' in title %}{{ title }}{% else %}{{ title }} — Ataraxia Lab{% endif %}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="https://ataraxialab.ch/images/og-default.jpg">

  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" type="image/svg+xml" href="/images/logo_ataraxialab_plein.svg">

  <!-- JSON-LD Organization (toutes les pages) -->
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Ataraxia Lab",
  "url": "https://ataraxialab.ch",
  "logo": "https://ataraxialab.ch/images/logo_ataraxialab_plein.svg",
  "description": "Association à but non lucratif réunissant des passionné·e·s du numérique en Suisse romande pour construire ensemble une technologie éthique, ouverte et responsable.",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Crêt-Vaillant 22",
    "addressLocality": "Le Locle",
    "postalCode": "2400",
    "addressCountry": "CH"
  },
  "email": "contact@ataraxialab.ch",
  "foundingDate": "2026",
  "nonprofitStatus": "NonprofitType"
}
</script>

  <!-- JSON-LD BreadcrumbList (tutoriels) — F-10 14.08.2026 -->
  {% if type == 'tutoriel' %}
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://ataraxialab.ch/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Tutoriels",
      "item": "https://ataraxialab.ch/tutoriels/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "{{ title }}",
      "item": "https://ataraxialab.ch{{ page.url }}"
    }
  ]
}
</script>
  {% endif %}

  <!-- JSON-LD BlogPosting (tutoriels uniquement) -->
  {% if type == 'tutoriel' %}
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "{{ title }}",
  "description": "{{ description }}",
  "image": "https://ataraxialab.ch/images/og-default.jpg",
  "datePublished": "{{ datePublished }}T00:00:00+02:00",
  "dateModified": "{{ datePublished }}T00:00:00+02:00",
  "url": "https://ataraxialab.ch{{ page.url }}",
  "inLanguage": "fr-CH",
  "author": {
    "@type": "Organization",
    "name": "Ataraxia Lab",
    "url": "https://ataraxialab.ch"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Ataraxia Lab",
    "logo": {
      "@type": "ImageObject",
      "url": "https://ataraxialab.ch/images/logo_ataraxialab_plein.svg"
    }
  },
  "keywords": "{{ categorie }}, numérique éthique, Suisse romande"
}
</script>
  {% endif %}

  <!-- Matomo — cookieless — LPD conforme — 02.06.2026 -->
  <script>
    var _paq = window._paq = window._paq || [];
    _paq.push(["disableCookies"]);
    _paq.push(['trackPageView']);
    _paq.push(['enableLinkTracking']);
    (function() {
      var u="https://stats.ataraxialab.ch/";
      _paq.push(['setTrackerUrl', u+'matomo.php']);
      _paq.push(['setSiteId', '1']);
      var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
      g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);
    })();
  </script>
  <!-- End Matomo -->

</head>
<body>
 <a href="#main-content" class="skip-nav">Aller au contenu principal</a>
