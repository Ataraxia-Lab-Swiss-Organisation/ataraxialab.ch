          </svg>
        </a>
      </div>
    </nav>
  </header>
  <main id="main-content">
    {{ content | safe }}

    {% if type == 'tutoriel' %}
    <section class="articles-lies">
      <h2>À lire aussi</h2>
      <ul class="tutoriels-grille">
        {% for art in tutoriels | articlesLies(categorie, page.fileSlug) %}
        <li class="tutoriel-carte">
          <span class="tutoriel-categorie">{{ art.categorie }}</span>
          <a class="tutoriel-titre tutoriel-lien" href="/tutoriels/{{ art.slug }}/">{{ art.titre }}</a>
        </li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}
  </main>
  <footer>
    <span>© 2026 Ataraxia Lab — Association à but non lucratif — CHE-425.759.729 — 2400 Le Locle — <a href="mailto:&#99;&#111;&#110;&#116;&#97;&#99;&#116;&#64;&#97;&#116;&#97;&#114;&#97;&#120;&#105;&#97;&#108;&#97;&#98;&#46;&#99;&#104;">&#99;&#111;&#110;&#116;&#97;&#99;&#116;&#64;&#97;&#116;&#97;&#114;&#97;&#120;&#105;&#97;&#108;&#97;&#98;&#46;&#99;&#104;</a> — <a href="/mentions-legales/">Mentions légales</a> · <a href="/confidentialite/">Confidentialité</a> · <a href="/conditions/">Conditions générales</a> · <a href="/charte-ethique/">Charte éthique IA</a> · <a href="/documents/statuts-ataraxia-lab.pdf">Statuts</a></span>
  </footer>
  <script>
    var toggle = document.querySelector('.nav-toggle');
    var navMenu = document.querySelector('nav');
    if (toggle && navMenu) {
      toggle.addEventListener('click', function() {
        var open = navMenu.classList.toggle('open');
        this.setAttribute('aria-expanded', open);
      });
    }
  </script>
</body>
</html>
